# Supabase (service role for worker DB writes; anon for JWT verification)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (reasoner + optional vision/scene facts)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REASONER_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# Progressive multimodal pipeline
PIPELINE_VERSION=v5-progressive
PROVIDER_VERSION=reasoner-gpt-4o-mini+mu-openai-gcp-v1
MIN_PRODUCTS=1
STAGE_PASS_CONFIDENCE=0.60
AUTO_APPROVE_CONFIDENCE=0.85
REVIEW_MIN_CONFIDENCE=0.60
TRANSCRIPT_MIN_CHARS=40
MAX_PRODUCTS_PER_INGEST=12
FRAME_COUNT_LT_10S=3
FRAME_COUNT_10_30S=3
FRAME_COUNT_30_90S=5
FRAME_COUNT_90S_5M=8
STAGE3_MAX_FRAMES=10

# BullMQ / Redis
REDIS_URL=redis://127.0.0.1:6379
# Set to false to run API without embedded worker (use npm run worker)
INGEST_WORKER_EMBEDDED=true

# Google Cloud Vision (OCR + Logo). Optional — pipeline continues without it.
GOOGLE_APPLICATION_CREDENTIALS=
GCP_VISION_ENABLED=true

# Tavily Extract (manual product link preview fallback)
TAVILY_API_KEY=

# Optional
PORT=8787
LOG_LEVEL=info
