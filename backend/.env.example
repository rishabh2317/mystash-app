# Supabase (service role for worker DB writes; anon for JWT verification)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=
#
# Progressive ingest (Stage 1 reasoner + Stage 2/3 vision/scene) prefers:
OPENAI_REASONER_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
#
# Migration from older setups that only had OPENAI_MODEL:
# - OPENAI_REASONER_MODEL falls back to OPENAI_MODEL, then gpt-4o-mini
# - OPENAI_VISION_MODEL falls back to the resolved reasoner model
# - You can keep OPENAI_MODEL as a shared default; set the two above to override
#   reasoner vs vision independently.
# OPENAI_MODEL is still read as that fallback (and by a few non-pipeline helpers).
OPENAI_MODEL=gpt-4o-mini

# Progressive multimodal pipeline
PIPELINE_VERSION=v5-progressive
PROVIDER_VERSION=reasoner-gpt-4o-mini+mu-openai-gcp-v1
MIN_PRODUCTS=1
STAGE_PASS_CONFIDENCE=0.60
AUTO_APPROVE_CONFIDENCE=0.85
REVIEW_MIN_CONFIDENCE=0.60
TRANSCRIPT_MIN_CHARS=40
MAX_PRODUCTS_PER_INGEST=12
FRAME_COUNT_LT_10S=3
FRAME_COUNT_10_30S=3
FRAME_COUNT_30_90S=5
FRAME_COUNT_90S_5M=8
STAGE3_MAX_FRAMES=10

# BullMQ / Redis (required for reliable queue; install Redis locally if missing)
#   brew install redis && brew services start redis
# BullMQ / progressive ingest (required for async extract queue)
# Start locally: ~/.local/bin/redis-server --daemonize yes
REDIS_URL=redis://127.0.0.1:6379
# Set to false to run API without embedded worker (use npm run worker)
INGEST_WORKER_EMBEDDED=true

# Google Cloud Vision (OCR + Logo). Optional — pipeline continues without it.
# Absolute path to a GCP service-account JSON key with Vision API enabled.
GOOGLE_APPLICATION_CREDENTIALS=
GCP_VISION_ENABLED=true

# Tavily Extract (manual product link preview + auto PDP metadata after Serper)
TAVILY_API_KEY=

# Product Intelligence & Catalog (post-extract)
PRODUCT_INTELLIGENCE_ENABLED=true
PRODUCT_RESOLVE_BACKGROUND=true
# Product web search: serper (default) | google_cse
PRODUCT_SEARCH_PROVIDER=serper
SERPER_API_KEY=
# Optional fallback when PRODUCT_SEARCH_PROVIDER=google_cse
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
CATALOG_HIT_MIN_SCORE=0.85
CATALOG_MATCH_EPSILON=0.05
PRODUCT_SPECIFICITY_MIN=0.55
PRODUCT_VERIFICATION_MATCH_MIN=0.45
PDP_CLASSIFIER_MIN_SCORE=0.45
SEARCH_CACHE_TTL_HOURS=168
AFFILIATE_CACHE_TTL_DAYS=30
CATALOG_VERIFICATION_VERSION=v1
# Max trusted PDPs to enrich per product (multi-source metadata)
METADATA_ENRICH_MAX_CANDIDATES=5

# Shopping resolution (affiliate URLs are ignored unless a real provider is enabled)
AFFILIATE_ENABLED=false
AFFILIATE_PROVIDER=none
# Commerce priority independent of metadata quality (comma-separated)
SHOPPING_PROVIDER_PRIORITY=amazon,official,flipkart,myntra,ajio,bestbuy,merchant

# Optional
PORT=8787
LOG_LEVEL=info
