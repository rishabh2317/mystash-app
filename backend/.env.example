# Supabase (service role for worker DB writes; anon for JWT verification)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (extraction + moderation + Tavily link-preview parser; default model gpt-4o-mini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Tavily Extract (JS-heavy product pages — link preview fallback after manual scrape)
TAVILY_API_KEY=

# Optional
PORT=8787
LOG_LEVEL=info
EXTRACTION_PIPELINE_VERSION=v4-backend-unified
