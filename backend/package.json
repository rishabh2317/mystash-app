{
  "name": "mystash-backend",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "test": "tsx --test $(find src -name '*.test.ts' ! -name '*.integration.test.ts')",
    "test:unit": "npm test",
    "test:search:integration": "tsx --test src/search/index/OpenSearchIndex.integration.test.ts",
    "test:all": "npm test && npm run test:search:integration",
    "search:bootstrap": "tsx scripts/bootstrapSearchIndex.ts"
  },
  "dependencies": {
    "@google-cloud/vision": "^4.3.2",
    "@supabase/supabase-js": "^2.49.8",
    "bullmq": "^5.34.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "openai": "^6.37.0",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
