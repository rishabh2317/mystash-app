{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "ios-simulator": {
      "distribution": "internal",
      "environment": "preview",
      "ios": {
        "simulator": true,
        "buildConfiguration": "Release"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_NOTIFICATIONS_ENABLED": "true",
        "EXPO_PUBLIC_PUSH_ENABLED": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_NOTIFICATIONS_ENABLED": "true",
        "EXPO_PUBLIC_PUSH_ENABLED": "true"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
