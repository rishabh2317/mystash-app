# Optional root-context image. Existing backend-context deployment remains intact.
FROM node:22.18.0-bookworm-slim AS web
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci --include=dev
COPY app.config.js app.json babel.config.js eas.json tsconfig.json ./
COPY scripts/renderBuildEnv.cjs ./scripts/renderBuildEnv.cjs
COPY public-web ./public-web
COPY components ./components
COPY contexts ./contexts
COPY src ./src
COPY hooks ./hooks
COPY constants ./constants
COPY modules ./modules
COPY assets ./assets
COPY backend/src ./backend/src
ARG SUPABASE_URL
ARG SUPABASE_ANON_KEY
ARG EXPO_PUBLIC_SUPABASE_URL
ARG EXPO_PUBLIC_SUPABASE_ANON_KEY
ARG EXPO_PUBLIC_MYSTASH_ANDROID_STORE_URL
ARG EXPO_PUBLIC_MYSTASH_IOS_STORE_URL
ENV MYSTASH_PUBLIC_WEB=true EXPO_NO_DOTENV=1 EXPO_PUBLIC_PUBLIC_STASH_ENABLED=true EXPO_PUBLIC_ANALYTICS_ENABLED=true EXPO_PUBLIC_MYSTASH_INGEST_URL=https://mystash-free-test.onrender.com
RUN export EXPO_PUBLIC_SUPABASE_URL="${EXPO_PUBLIC_SUPABASE_URL:-$SUPABASE_URL}" EXPO_PUBLIC_SUPABASE_ANON_KEY="${EXPO_PUBLIC_SUPABASE_ANON_KEY:-$SUPABASE_ANON_KEY}" && test -n "$EXPO_PUBLIC_SUPABASE_URL" && test -n "$EXPO_PUBLIC_SUPABASE_ANON_KEY" && npx expo export --platform web --output-dir /web-export && cp assets/images/icon.png /web-export/public-stash-share.png
FROM node:22.18.0-bookworm-slim AS api
WORKDIR /app
COPY backend/package.json backend/package-lock.json ./
RUN npm ci --include=dev
COPY backend/tsconfig.json ./
COPY backend/src ./src
RUN npm run build && npm prune --omit=dev
FROM node:22.18.0-bookworm-slim
ENV NODE_ENV=production INGEST_WORKER_EMBEDDED=false PUBLIC_STASH_WEB_DIR=/app/public-web PATH="/opt/video-tools/bin:${PATH}"
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates ffmpeg python3 python3-venv && python3 -m venv /opt/video-tools && /opt/video-tools/bin/pip install --no-cache-dir 'yt-dlp[default]==2026.10.26' && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=api --chown=node:node /app/node_modules ./node_modules
COPY --from=api --chown=node:node /app/dist ./dist
COPY --from=api --chown=node:node /app/package.json ./package.json
COPY --from=web --chown=node:node /web-export ./public-web
COPY --chown=node:node backend/config/shopping.json ./config/shopping.json
USER node
CMD ["node","dist/index.js"]
